local function Notify(titleText, bodyText, duration, isWarning)
    task.spawn(function()
        local accentColor = isWarning and ThemeColors.WarningOrange or Themes[QuantumConfig.Theme]

        local Card = Instance.new("Frame")
        Card.Size = UDim2.new(1, 0, 0, 54)
        Card.BackgroundColor3 = isWarning and Color3.fromRGB(32, 22, 18) or ThemeColors.CardBG
        Card.BackgroundTransparency = 1
        AddCorner(Card, 10)
        local Stroke = AddStroke(Card, accentColor, 1.4)
        Stroke.Transparency = 1
        Card.Parent = NotifContainer

        local TLabel = Instance.new("TextLabel")
        TLabel.Size = UDim2.new(1, -20, 0, 18)
        TLabel.Position = UDim2.new(0, 12, 0, 6)
        TLabel.BackgroundTransparency = 1
        TLabel.Text = titleText
        TLabel.TextColor3 = accentColor
        TLabel.Font = Enum.Font.GothamBold
        TLabel.TextSize = 12
        TLabel.TextXAlignment = Enum.TextXAlignment.Left
        TLabel.TextTransparency = 1
        TLabel.Parent = Card

        local BLabel = Instance.new("TextLabel")
        BLabel.Size = UDim2.new(1, -20, 0, 22)
        BLabel.Position = UDim2.new(0, 12, 0, 24)
        BLabel.BackgroundTransparency = 1
        BLabel.Text = bodyText
        BLabel.TextColor3 = ThemeColors.TextWhite
        BLabel.Font = Enum.Font.GothamMedium
        BLabel.TextSize = 11
        BLabel.TextWrapped = true
        BLabel.TextXAlignment = Enum.TextXAlignment.Left
        BLabel.TextTransparency = 1
        BLabel.Parent = Card

        TweenService:Create(Card, TweenInfo.new(0.22), {BackgroundTransparency = 0.04}):Play()
        TweenService:Create(Stroke, TweenInfo.new(0.22), {Transparency = 0}):Play()
        TweenService:Create(TLabel, TweenInfo.new(0.22), {TextTransparency = 0}):Play()
        TweenService:Create(BLabel, TweenInfo.new(0.22), {TextTransparency = 0}):Play()

        task.wait(duration or 3.0)
        if Card and Card.Parent then
            TweenService:Create(Card, TweenInfo.new(0.22), {BackgroundTransparency = 1}):Play()
            TweenService:Create(Stroke, TweenInfo.new(0.22), {Transparency = 1}):Play()
            TweenService:Create(TLabel, TweenInfo.new(0.22), {TextTransparency = 1}):Play()
            TweenService:Create(BLabel, TweenInfo.new(0.22), {TextTransparency = 1}):Play()
            task.wait(0.22)
            pcall(function() Card:Destroy() end)
        end
    end)
end

