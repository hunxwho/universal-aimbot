    esp.Box.Visible = false
    esp.BoxFill.Visible = false
    esp.Name.Visible = false
    esp.Tracer.Visible = false
    esp.HeadDot.Visible = false
    esp.HealthBG.Visible = false
    esp.HealthBar.Visible = false
    esp.OffScreenArrow.Visible = false
    for i = 1, #esp.Corners do esp.Corners[i].Visible = false end
    for i = 1, #esp.Bones do esp.Bones[i].Visible = false end
end

local function RemoveESPData(model)
    local esp = ESP_Objects[model]
    if esp then
        pcall(function()
            esp.Name:Remove() 
            esp.Tracer:Remove()
            esp.Box:Remove()
            esp.BoxFill:Remove()
            esp.HeadDot:Remove()
            esp.HealthBG:Remove()
            esp.HealthBar:Remove()
            esp.OffScreenArrow:Remove()
            for _, c in ipairs(esp.Corners) do c:Remove() end
            for _, l in ipairs(esp.Bones) do l:Remove() end
        end)
        ESP_Objects[model] = nil
    end
end

local function ResolveCustomPlayerCharacter(player)
    if player.Character and IsAliveAndValid(player.Character) then
        return player.Character
    end
    if not QuantumConfig.CustomRigSupport then return nil end

    -- Check common custom character folders used in custom-rig games
    local customFolders = {"Characters", "Players", "Entities", "Live", "Units", "SpawnedPlayers"}
    for _, folderName in ipairs(customFolders) do
        local folder = workspace:FindFirstChild(folderName)
        if folder then
            local found = folder:FindFirstChild(player.Name) or folder:FindFirstChild(tostring(player.UserId))
            if found and found:IsA("Model") and IsAliveAndValid(found) then
                return found
            end
        end
    end
    return nil
end

local function RefreshActiveEntities()
    local seenModels = {}
    local playerCount = 0
    local botCount = 0
    local newTargetNames = {"None"}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = ResolveCustomPlayerCharacter(player)
            if char then
                seenModels[char] = true
                playerCount = playerCount + 1
                local dName = player.DisplayName or player.Name
                ActiveEntities[char] = {
                    Model = char,
                    Player = player,
                    IsBot = false,
                    Name = dName
                }
                table.insert(newTargetNames, dName)
            end
        end
    end

    if QuantumConfig.IncludeBots then
        for botModel, _ in pairs(DiscoveredBotModels) do
            if not botModel or not botModel.Parent then
                DiscoveredBotModels[botModel] = nil
            elseif not seenModels[botModel] and botModel ~= LocalPlayer.Character then
                local ownerPlayer = Players:GetPlayerFromCharacter(botModel)
                if not ownerPlayer and IsAliveAndValid(botModel) then
                    seenModels[botModel] = true
                    botCount = botCount + 1
                    local hum = GetCharacterHumanoid(botModel)
                    local displayName = (hum and hum.DisplayName ~= "" and hum.DisplayName) or botModel.Name
                    ActiveEntities[botModel] = {
                        Model = botModel,
                        Player = nil,
                        IsBot = true,
                        Name = displayName
                    }
                    table.insert(newTargetNames, displayName)
                end
            end
        end
    end

    for model, _ in pairs(ActiveEntities) do
        if not seenModels[model] or not IsAliveAndValid(model) then
            RestoreCharacterHitboxes(model)
            local hl = model and model:FindFirstChild("QuantumChams")
            if hl then hl.Enabled = false end
            RemoveESPData(model)
            ActiveEntities[model] = nil
        end
    end

    table.clear(TargetSelectOptions)
    for _, n in ipairs(newTargetNames) do
        table.insert(TargetSelectOptions, n)
    end
    if RefreshTargetCycle then pcall(RefreshTargetCycle) end

    EntitiesLabel.Text = string.format("Players: %d | Bots/Rigs: %d", playerCount, botCount)
end

