local CustomSkinSubNames = {
    ["skin"] = true, ["rig"] = true, ["visual"] = true, ["visuals"] = true,
    ["morph"] = true, ["character"] = true, ["charactermodel"] = true,
    ["customrig"] = true, ["mesh"] = true, ["body"] = true, ["armor"] = true,
    ["costume"] = true, ["outfit"] = true
}

local RootCandidateNames = {
    "HumanoidRootPart", "RootPart", "Root", "Torso", "UpperTorso", "LowerTorso",
    "Pelvis", "Hips", "Core", "Center", "Chassis", "Main", "Body", "Hitbox", "Collider"
}

local HeadCandidateNames = {
    "Head", "HeadHitbox", "FakeHead", "Skull", "Cranium", "Face", "Helmet", "Crit", "Top"
}

local function GetCharacterHumanoid(char)
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid") or char:FindFirstChild("Humanoid")
    if hum then return hum end
    if QuantumConfig.CustomRigSupport then
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Model") and CustomSkinSubNames[string.lower(child.Name)] then
                local subHum = child:FindFirstChildOfClass("Humanoid")
                if subHum then return subHum end
            end
        end
    end
    return nil
end

local function InspectAndCacheCustomRig(char)
    if not char then return nil end
    local cached = RigCache[char]
    if cached and (tick() - cached.Timestamp < 1.5) and cached.Root and cached.Root.Parent then
        return cached
    end

    local data = {
        Timestamp = tick(),
        Root = nil,
        Head = nil,
        HeadBone = nil,
        Bones = {},
        MotorJoints = {}
    }

    local hum = GetCharacterHumanoid(char)
    if hum and hum.RootPart and hum.RootPart:IsA("BasePart") then
        data.Root = hum.RootPart
    end

    if not data.Root then
        for _, rName in ipairs(RootCandidateNames) do
            local p = char:FindFirstChild(rName, true)
            if p and p:IsA("BasePart") then
                data.Root = p
                break
            end
        end
    end

    if not data.Root and char:IsA("Model") and char.PrimaryPart then
        data.Root = char.PrimaryPart
    end

    for _, hName in ipairs(HeadCandidateNames) do
        local p = char:FindFirstChild(hName, true)
        if p then
            if p:IsA("BasePart") then
                data.Head = p
                break
            elseif p:IsA("Bone") then
                data.HeadBone = p
                break
            end
        end
    end

    local highestPart = nil
    local highestY = -math.huge
    local largestPart = nil
    local largestVol = -1

    for _, desc in ipairs(char:GetDescendants()) do
        if desc:IsA("BasePart") then
            local vol = desc.Size.X * desc.Size.Y * desc.Size.Z
            if vol > largestVol and desc.Name ~= "Handle" then
                largestVol = vol
                largestPart = desc
            end
            if desc.Position.Y > highestY and desc.Name ~= "Handle" then
                highestY = desc.Position.Y
                highestPart = desc
            end
        elseif desc:IsA("Bone") then
            table.insert(data.Bones, desc)
            local lowerBone = string.lower(desc.Name)
            if not data.HeadBone and (string.find(lowerBone, "head") or string.find(lowerBone, "skull") or string.find(lowerBone, "neck")) then
                data.HeadBone = desc
            end
        elseif (desc:IsA("Motor6D") or desc:IsA("Weld")) and desc.Part0 and desc.Part1 then
            if desc.Part0.Parent ~= desc.Part1 and not string.find(string.lower(desc.Part1.Name), "handle") then
                table.insert(data.MotorJoints, {desc.Part0, desc.Part1})
            end
        end
    end

    if not data.Root then
        data.Root = largestPart or highestPart
    end
    if not data.Head then
        data.Head = highestPart or data.Root
    end

    RigCache[char] = data
    return data
end

local function GetCharacterRoot(char)
    if not char then return nil end
    local fastRoot = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    if fastRoot and fastRoot:IsA("BasePart") then
        return fastRoot
    end
    local rigData = InspectAndCacheCustomRig(char)
    return rigData and rigData.Root or nil
end

local function GetCharacterHead(char)
    if not char then return nil end
    local fastHead = char:FindFirstChild("Head")
    if fastHead and fastHead:IsA("BasePart") then
        return fastHead
    end
    local rigData = InspectAndCacheCustomRig(char)
    return (rigData and rigData.Head) or GetCharacterRoot(char)
end

local function GetHeadWorldPosition(char)
    local rigData = InspectAndCacheCustomRig(char)
    if rigData and rigData.HeadBone and rigData.HeadBone.Parent then
        local ok, pos = pcall(function() return rigData.HeadBone.TransformedWorldCFrame.Position end)
        if ok and pos then return pos end
    end
    local headPart = GetCharacterHead(char)
    if headPart then
        return headPart.Position
    end
    local rootPart = GetCharacterRoot(char)
    return rootPart and (rootPart.Position + Vector3.new(0, 2.2, 0)) or Vector3.zero
end

local function GetCharacterBounds(char, rootPart)
    local headPos = GetHeadWorldPosition(char)
    local topWorld = headPos + Vector3.new(0, 0.85, 0)
    local botWorld = rootPart.Position - Vector3.new(0, 3.0, 0)

    if QuantumConfig.CustomRigSupport and char:IsA("Model") then
        local ok, cf, size = pcall(function() return char:GetBoundingBox() end)
        if ok and cf and size and size.Y > 1.5 and size.Y < 45 then
            local halfY = math.clamp(size.Y * 0.5, 1.5, 20)
            topWorld = cf.Position + Vector3.new(0, halfY, 0)
            botWorld = cf.Position - Vector3.new(0, halfY, 0)
        end
    end

    return topWorld, botWorld, headPos
end

