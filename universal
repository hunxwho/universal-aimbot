local function GetEntityHealthAndMax(char)
    if not char then return 0, 0 end
    local hum = GetCharacterHumanoid(char)
    if hum then
        if hum.MaxHealth > 0 then
            return hum.Health, hum.MaxHealth
        else
            return 100, 100
        end
    end

    local attrHp = char:GetAttribute("Health") or char:GetAttribute("HP") or char:GetAttribute("CurrentHealth") or char:GetAttribute("Shield")
    local attrMax = char:GetAttribute("MaxHealth") or char:GetAttribute("MaxHP") or 100
    if type(attrHp) == "number" then
        return attrHp, (type(attrMax) == "number" and attrMax > 0) and attrMax or 100
    end

    local hpObj = char:FindFirstChild("Health", true) or char:FindFirstChild("HP", true)
    if hpObj and (hpObj:IsA("NumberValue") or hpObj:IsA("IntValue")) then
        local maxObj = char:FindFirstChild("MaxHealth", true) or char:FindFirstChild("MaxHP", true)
        local maxVal = (maxObj and (maxObj:IsA("NumberValue") or maxObj:IsA("IntValue"))) and maxObj.Value or 100
        return hpObj.Value, math.max(maxVal, 1)
    end

    return 100, 100
end

local IgnoredAncestorNames = {
    ["corpses"] = true, ["ragdolls"] = true, ["dead"] = true, ["debris"] = true,
    ["viewmodel"] = true, ["camera"] = true, ["ignore"] = true, ["effects"] = true,
    ["weapons"] = true, ["dropped"] = true, ["items"] = true, ["shop"] = true,
    ["lobby"] = true, ["map"] = true, ["props"] = true, ["scenery"] = true
}

local function GetTopCharacterContainer(model)
    local curr = model
    while curr.Parent and curr.Parent:IsA("Model") and curr.Parent ~= workspace do
        local pLower = string.lower(curr.Parent.Name)
        if CustomSkinSubNames[string.lower(curr.Name)] or curr.Parent:FindFirstChildOfClass("Humanoid") or Players:GetPlayerFromCharacter(curr.Parent) then
            curr = curr.Parent
        elseif pLower ~= "characters" and pLower ~= "players" and pLower ~= "enemies" and pLower ~= "bots" and pLower ~= "npcs" and pLower ~= "entities" and pLower ~= "live" then
            break
        else
            break
        end
    end
    return curr
end

local function HasValidAncestorPath(model)
    local curr = model.Parent
    while curr and curr ~= workspace do
        if curr == LocalPlayer.Character or curr == Camera then
            return false
        end
        local lowerName = string.lower(curr.Name)
        if IgnoredAncestorNames[lowerName] then
            return false
        end
        if curr:IsA("Model") and (curr:FindFirstChildOfClass("Humanoid") or Players:GetPlayerFromCharacter(curr)) then
            return false
        end
        curr = curr.Parent
    end
    return curr == workspace
end

local function IsValidBotModel(model)
    if not model or not model:IsA("Model") or model == LocalPlayer.Character then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    if not HasValidAncestorPath(model) then return false end

    local hum = GetCharacterHumanoid(model)
    local animCtrl = model:FindFirstChildOfClass("AnimationController") or model:FindFirstChildWhichIsA("Animator", true)
    local hasHealthData = (model:GetAttribute("Health") ~= nil) or (model:GetAttribute("HP") ~= nil) or (model:FindFirstChild("Health") ~= nil)
    local hasStandardRig = (model:FindFirstChild("Head", true) ~= nil) and (
        model:FindFirstChild("HumanoidRootPart", true) ~= nil or
        model:FindFirstChild("Torso", true) ~= nil or
        model:FindFirstChild("UpperTorso", true) ~= nil or
        model:FindFirstChildWhichIsA("Bone", true) ~= nil
    )

    if not (hum or animCtrl or hasHealthData or hasStandardRig) then
        return false
    end

    return GetCharacterRoot(model) ~= nil
end

local function IsAliveAndValid(char)
    if not char or not char.Parent or char == LocalPlayer.Character then return false end
    if not workspace:IsAncestorOf(char) then return false end
    if QuantumConfig.IgnoreForceField and char:FindFirstChildOfClass("ForceField") then
        return false
    end

    local root = GetCharacterRoot(char)
    local head = GetCharacterHead(char)
    if not root or not head then return false end
    
    local hum = GetCharacterHumanoid(char)
    if hum then
        if hum:GetState() == Enum.HumanoidStateType.Dead then return false end
        return hum.Health > 0 or hum.MaxHealth == 0
    end

    local hp, _ = GetEntityHealthAndMax(char)
    return hp > 0
end

local function CheckTeam(entityData)
    if not QuantumConfig.TeamCheck then return true end
    if not entityData then return true end

    local player = entityData.Player
    if player and LocalPlayer.Team ~= nil and player.Team ~= nil then
        return player.Team ~= LocalPlayer.Team
    end

    local model = entityData.Model
    if model and LocalPlayer.Team ~= nil then
        local myTeamName = string.lower(LocalPlayer.Team.Name)

        local teamVal = model:FindFirstChild("Team") or model:FindFirstChild("TeamColor") or model:FindFirstChild("Faction")
        if teamVal and teamVal:IsA("ValueBase") then
            if teamVal.Value == LocalPlayer.Team or teamVal.Value == LocalPlayer.TeamColor or tostring(teamVal.Value):lower() == myTeamName then
                return false
            end
        end

        local attrTeam = model:GetAttribute("Team") or model:GetAttribute("TeamColor") or model:GetAttribute("Faction")
        if attrTeam and (tostring(attrTeam):lower() == myTeamName or attrTeam == LocalPlayer.TeamColor) then
            return false
        end

        local parentFolder = model.Parent
        if parentFolder and parentFolder ~= workspace then
            local pName = string.lower(parentFolder.Name)
            if pName == myTeamName or pName == string.lower(LocalPlayer.TeamColor.Name) then
                return false
            end
        end
    end

    return true
end

local function IsVisible(targetPart, targetChar)
    if not targetPart then return false end
    local origin = Camera.CFrame.Position
    local targetPos = (typeof(targetPart) == "Vector3") and targetPart or targetPart.Position
    local displacement = targetPos - origin
    local distance = displacement.Magnitude
    if distance < 1 then return true end

    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = true

    local result = workspace:Raycast(origin, displacement.Unit * distance, raycastParams)
    return result == nil or (targetChar and targetChar:IsAncestorOf(result.Instance))
end

local function EvaluateInstanceForBot(inst)
    if not inst then return end
    local candidateModel = nil
    if inst:IsA("Humanoid") or inst:IsA("AnimationController") then
        candidateModel = inst.Parent
    elseif inst:IsA("Bone") then
        candidateModel = inst:FindFirstAncestorOfClass("Model")
    elseif inst:IsA("BasePart") and (inst.Name == "HumanoidRootPart" or inst.Name == "Head" or inst.Name == "RootPart") then
        candidateModel = inst.Parent
    elseif inst:IsA("Model") then
        candidateModel = inst
    end

    if candidateModel and candidateModel:IsA("Model") then
        candidateModel = GetTopCharacterContainer(candidateModel)
        if not DiscoveredBotModels[candidateModel] and IsValidBotModel(candidateModel) then
            DiscoveredBotModels[candidateModel] = true
        end
    end
end

