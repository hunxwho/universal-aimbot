local function DeepReplace(tbl, targetPos, targetCF, targetInst, depth)
    depth = (depth or 0) + 1
    if depth > 4 then return end
    for k, v in pairs(tbl) do
        if typeof(v) == "Vector3" then
            tbl[k] = targetPos
        elseif typeof(v) == "CFrame" then
            tbl[k] = targetCF
        elseif typeof(v) == "Instance" and v:IsA("BasePart") then
            tbl[k] = targetInst
        elseif type(v) == "table" then
            DeepReplace(v, targetPos, targetCF, targetInst, depth)
        end
    end
end

local OriginalNamecall = nil
local OriginalIndex = nil

if hookmetamethod and getnamecallmethod and checkcaller then
    OriginalNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if not IsUnloaded and QuantumConfig.SilentAim and not checkcaller() then
            if math.random(1, 100) <= QuantumConfig.HitChance then
                local targetChar = CachedBestTarget
                if targetChar and IsAliveAndValid(targetChar) then
                    local targetPart = GetTargetPart(targetChar)
                    if targetPart then
                        local hitPos = GetPredictedPosition(targetPart, targetChar)
                        local hitCF = CFrame.new(hitPos)
                        
                        if method == "Raycast" or method == "Spherecast" or method == "Blockcast" then
                            if typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" then
                                local origMag = math.max(args[2].Magnitude, 1000)
                                args[2] = (hitPos - args[1]).Unit * origMag
                                return OriginalNamecall(self, unpack(args))
                            end
                        elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" then
                            if typeof(args[1]) == "Ray" then
                                local origMag = math.max(args[1].Direction.Magnitude, 1000)
                                args[1] = Ray.new(args[1].Origin, (hitPos - args[1].Origin).Unit * origMag)
                                return OriginalNamecall(self, unpack(args))
                            end
                        elseif method == "ScreenPointToRay" or method == "ViewportPointToRay" then
                            local origin = Camera.CFrame.Position
                            local direction = (hitPos - origin).Unit
                            return Ray.new(origin, direction)
                        elseif method == "FireServer" or method == "InvokeServer" then
                            for i, v in pairs(args) do
                                if typeof(v) == "Vector3" then
                                    args[i] = hitPos
                                elseif typeof(v) == "CFrame" then
                                    args[i] = hitCF
                                elseif typeof(v) == "Instance" and v:IsA("BasePart") then
                                    args[i] = targetPart
                                elseif type(v) == "table" then
                                    DeepReplace(v, hitPos, hitCF, targetPart, 0)
                                end
                            end
                            return OriginalNamecall(self, unpack(args))
                        end
                    end
                end
            end
        end
        return OriginalNamecall(self, ...)
    end)

    OriginalIndex = hookmetamethod(game, "__index", function(self, key)
        if not IsUnloaded and QuantumConfig.SilentAim and not checkcaller() then
            if self == Mouse and (key == "Target" or key == "Hit" or key == "UnitRay") then
                if math.random(1, 100) <= QuantumConfig.HitChance then
                    local targetChar = CachedBestTarget
                    if targetChar and IsAliveAndValid(targetChar) then
                        local targetPart = GetTargetPart(targetChar)
                        if targetPart then
                            local hitPos = GetPredictedPosition(targetPart, targetChar)
                            if key == "Target" then
                                return targetPart
                            elseif key == "Hit" then
                                return CFrame.new(hitPos)
                            elseif key == "UnitRay" then
                                local origin = Camera.CFrame.Position
                                local direction = (hitPos - origin).Unit
                                return Ray.new(origin, direction)
                            end
                        end
                    end
                end
            end
        end
        return OriginalIndex(self, key)
    end)
end

