local function GetTargetPart(char)
    if not IsAliveAndValid(char) then return nil end
    local mode = QuantumConfig.SilentAimPart
    if mode == "Random" then
        local validParts = {}
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" and p.Name ~= "Handle" then
                table.insert(validParts, p)
            end
        end
        if #validParts > 0 then
            return validParts[math.random(1, #validParts)]
        end
        return GetCharacterHead(char) or GetCharacterRoot(char)
    elseif mode == "Closest" then
        local closestPart = nil
        local shortestDist = math.huge
        local mousePos = UserInputService:GetMouseLocation()
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.Name ~= "Handle" then
                local pt, onScreen = Camera:WorldToViewportPoint(p.Position)
                if onScreen then
                    local dist = (Vector2.new(pt.X, pt.Y) - mousePos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestPart = p
                    end
                end
            end
        end
        return closestPart or GetCharacterHead(char) or GetCharacterRoot(char)
    elseif mode == "Head" then
        return GetCharacterHead(char) or GetCharacterRoot(char)
    else
        return char:FindFirstChild(mode, true) or GetCharacterRoot(char) or GetCharacterHead(char)
    end
end

local function GetPredictedPosition(targetPart, char)
    if not targetPart then return Vector3.zero end
    local basePos = targetPart.Position
    if char and targetPart == GetCharacterHead(char) then
        basePos = GetHeadWorldPosition(char)
    end
    if not QuantumConfig.Prediction then return basePos end
    local vel = targetPart.AssemblyLinearVelocity or Vector3.zero
    return basePos + (vel * QuantumConfig.PredictionAmount)
end

local function FindEntityFromDescendant(inst)
    if not inst then return nil end
    for model, entityData in pairs(ActiveEntities) do
        if model == inst or model:IsAncestorOf(inst) then
            return entityData
        end
    end
    return nil
end

local function IsAimbotKeyDown()
    local key = QuantumConfig.AimbotKey
    if typeof(key) == "EnumItem" then
        if key.EnumType == Enum.UserInputType then
            return UserInputService:IsMouseButtonPressed(key)
        elseif key.EnumType == Enum.KeyCode then
            return UserInputService:IsKeyDown(key)
        end
    end
    return false
end

local function GetTriggerBotTarget(mousePos)
    if QuantumConfig.TriggerWithSilentAim and QuantumConfig.SilentAim and CachedBestTarget and IsAliveAndValid(CachedBestTarget) then
        local ent = ActiveEntities[CachedBestTarget]
        if ent and CheckTeam(ent) and (not ent.IsBot or QuantumConfig.IncludeBots) then
            return ent
        end
    end

    if Mouse.Target then
        local ent = FindEntityFromDescendant(Mouse.Target)
        if ent and IsAliveAndValid(ent.Model) and CheckTeam(ent) and (not ent.IsBot or QuantumConfig.IncludeBots) then
            return ent
        end
    end

    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.IgnoreWater = true

    local unitRay = Camera:ViewportPointToRay(mousePos.X, mousePos.Y)
    local rayResult = workspace:Raycast(unitRay.Origin, unitRay.Direction * 2500, rayParams)
    if rayResult and rayResult.Instance then
        local ent = FindEntityFromDescendant(rayResult.Instance)
        if ent and IsAliveAndValid(ent.Model) and CheckTeam(ent) and (not ent.IsBot or QuantumConfig.IncludeBots) then
            return ent
        end
    end

    for model, ent in pairs(ActiveEntities) do
        if IsAliveAndValid(model) and CheckTeam(ent) and (not ent.IsBot or QuantumConfig.IncludeBots) then
            local hrp = GetCharacterRoot(model)
            if hrp then
                local topW, botW, headW = GetCharacterBounds(model, hrp)
                local hPos, hVis = Camera:WorldToViewportPoint(topW)
                local rPos, rVis = Camera:WorldToViewportPoint(botW)
                if hVis and rVis then
                    local height = math.abs(rPos.Y - hPos.Y)
                    local width = math.max(height * 0.58, 18)
                    local centerX, centerY = (hPos.X + rPos.X) / 2, (hPos.Y + rPos.Y) / 2
                    if math.abs(mousePos.X - centerX) <= width / 2 and math.abs(mousePos.Y - centerY) <= height / 2 then
                        if not QuantumConfig.WallCheck or IsVisible(headW, model) or IsVisible(hrp, model) then
                            return ent
                        end
                    end
                end
            end
        end
    end

    return nil
end

local function ExecuteTriggerShot(mousePos)
    if IsFiringTrigger then return end
    if QuantumConfig.MenuOpen and MainFrame.Visible then
        local mPos = MainFrame.AbsolutePosition
        local mSize = MainFrame.AbsoluteSize
        if mousePos.X >= mPos.X and mousePos.X <= mPos.X + mSize.X and mousePos.Y >= mPos.Y and mousePos.Y <= mPos.Y + mSize.Y then
            return
        end
    end

    IsFiringTrigger = true
    task.spawn(function()
        local fired = false

        if type(mouse1press) == "function" and type(mouse1release) == "function" then
            pcall(mouse1press)
            task.wait(0.03)
            pcall(mouse1release)
            fired = true
        elseif type(mouse1click) == "function" then
            pcall(mouse1click)
            fired = true
        end

        if not fired and VirtualInputManager then
            pcall(function()
                VirtualInputManager:SendMouseButtonEvent(mousePos.X, mousePos.Y, 0, true, game, 1)
                task.wait(0.03)
                VirtualInputManager:SendMouseButtonEvent(mousePos.X, mousePos.Y, 0, false, game, 1)
                fired = true
            end)
        end

        local char = LocalPlayer.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        if tool then
            pcall(function() tool:Activate() end)
        end

        IsFiringTrigger = false
    end)
end

