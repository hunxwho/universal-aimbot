    ValueText.TextTruncate = Enum.TextTruncate.AtEnd
    ValueText.Parent = ValueBox
    table.insert(ThemeElements, {inst = ValueText, prop = "TextColor3"})
    
    local index = 1
    local function SyncCycleState()
        if #options == 0 then
            ValueText.Text = "None"
            return
        end
        for i, opt in ipairs(options) do
            if opt == QuantumConfig[configKey] then 
                index = i 
                break 
            end
        end
        if index > #options then index = 1 end
        ValueText.Text = tostring(options[index])
    end
    SyncCycleState()
    table.insert(UIControlRefreshers, SyncCycleState)
    
    TrackConnection(Frame.MouseButton1Click:Connect(function()
        if #options == 0 then return end
        index = (index % #options) + 1
        QuantumConfig[configKey] = options[index]
        ValueText.Text = tostring(options[index])
        if isThemeCycle then UpdateTheme() end
        if configKey == "WorldTheme" then UpdateWorld() end
    end))

    return SyncCycleState
