-- Custom Rig Hitbox Expander
local HitboxTargetNames = {"HumanoidRootPart", "Head", "Torso", "UpperTorso", "RootPart", "Body", "Hitbox"}

local function RestoreCharacterHitboxes(char)
    if not char then return end
    for _, partName in ipairs(HitboxTargetNames) do
        local part = char:FindFirstChild(partName, true)
        if part and OriginalPartProperties[part] then
            local orig = OriginalPartProperties[part]
            pcall(function()
                part.Size = orig.Size
                part.Transparency = orig.Transparency
                part.Material = orig.Material
                part.Color = orig.Color
                part.CanCollide = orig.CanCollide
                part.Massless = orig.Massless
            end)
            OriginalPartProperties[part] = nil
        end
    end
end

local function UpdateCharacterHitbox(char, shouldExpand, activeColor)
    if not char then return end
    if not shouldExpand then
        RestoreCharacterHitboxes(char)
        return
    end

    local desiredName = QuantumConfig.HitboxPart
    local targetPart = char:FindFirstChild(desiredName, true)
    if desiredName == "Torso" and not targetPart then
        targetPart = char:FindFirstChild("UpperTorso", true) or GetCharacterRoot(char)
    elseif desiredName == "Head" and not targetPart then
        targetPart = GetCharacterHead(char)
    end
    if not targetPart or not targetPart:IsA("BasePart") then
        targetPart = GetCharacterRoot(char) or GetCharacterHead(char)
    end

    for _, partName in ipairs(HitboxTargetNames) do
        local p = char:FindFirstChild(partName, true)
        if p and p ~= targetPart and OriginalPartProperties[p] then
            local orig = OriginalPartProperties[p]
            pcall(function()
                p.Size = orig.Size
                p.Transparency = orig.Transparency
                p.Material = orig.Material
                p.Color = orig.Color
                p.CanCollide = orig.CanCollide
                p.Massless = orig.Massless
            end)
            OriginalPartProperties[p] = nil
        end
    end

    if targetPart and targetPart:IsA("BasePart") then
        if not OriginalPartProperties[targetPart] then
            OriginalPartProperties[targetPart] = {
                Size = targetPart.Size,
                Transparency = targetPart.Transparency,
                Material = targetPart.Material,
                Color = targetPart.Color,
                CanCollide = targetPart.CanCollide,
                Massless = targetPart.Massless
            }
        end
        local s = QuantumConfig.HitboxSize
        targetPart.Size = Vector3.new(s, s, s)
        targetPart.Transparency = QuantumConfig.HitboxTransparency
        targetPart.Material = Enum.Material.ForceField
        targetPart.Color = activeColor or QuantumConfig.ESP_Color
        targetPart.CanCollide = false
        targetPart.Massless = true
    end
end

-- Universal Skeleton Segment Builder (R15 + R6 + Custom Motor6D Rigs + Skinned Mesh Bones)
local R15Skeleton = {
    {"Head", "UpperTorso"},
    {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"},
    {"LeftUpperArm", "LeftLowerArm"},
    {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"},
    {"RightUpperArm", "RightLowerArm"},
    {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"},
    {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"},
    {"RightUpperLeg", "RightLowerLeg"},
    {"RightLowerLeg", "RightFoot"}
}

local function GetR6SkeletonPoints(char)
    local head = char:FindFirstChild("Head")
    local torso = char:FindFirstChild("Torso")
    local lArm = char:FindFirstChild("Left Arm")
    local rArm = char:FindFirstChild("Right Arm")
    local lLeg = char:FindFirstChild("Left Leg")
    local rLeg = char:FindFirstChild("Right Leg")
    if not (head and torso) then return {} end

    local neck = (torso.CFrame * CFrame.new(0, 1, 0)).Position
    local pelvis = (torso.CFrame * CFrame.new(0, -1, 0)).Position
    local joints = {
        {head.Position, neck},
        {neck, pelvis}
    }

    if lArm then
        local lShoulder = (torso.CFrame * CFrame.new(-1.5, 0.8, 0)).Position
        local lHand = (lArm.CFrame * CFrame.new(0, -0.8, 0)).Position
        table.insert(joints, {neck, lShoulder})
        table.insert(joints, {lShoulder, lHand})
    end
    if rArm then
        local rShoulder = (torso.CFrame * CFrame.new(1.5, 0.8, 0)).Position
        local rHand = (rArm.CFrame * CFrame.new(0, -0.8, 0)).Position
        table.insert(joints, {neck, rShoulder})
        table.insert(joints, {rShoulder, rHand})
    end
    if lLeg then
        local lHip = (torso.CFrame * CFrame.new(-0.5, -1, 0)).Position
        local lFoot = (lLeg.CFrame * CFrame.new(0, -0.8, 0)).Position
        table.insert(joints, {pelvis, lHip})
        table.insert(joints, {lHip, lFoot})
    end
    if rLeg then
        local rHip = (torso.CFrame * CFrame.new(0.5, -1, 0)).Position
        local rFoot = (rLeg.CFrame * CFrame.new(0, -0.8, 0)).Position
        table.insert(joints, {pelvis, rHip})
        table.insert(joints, {rHip, rFoot})
    end

    return joints
end

local function GetUniversalSkeletonSegments(char)
    local segments = {}

    -- 1. Standard R15
    if char:FindFirstChild("UpperTorso") then
        for i = 1, #R15Skeleton do
            local pair = R15Skeleton[i]
            local p1, p2 = char:FindFirstChild(pair[1]), char:FindFirstChild(pair[2])
            if p1 and p2 and p1:IsA("BasePart") and p2:IsA("BasePart") then
                table.insert(segments, {p1.Position, p2.Position})
            end
        end
        if #segments > 0 then return segments end
    end

    -- 2. Standard R6
    if char:FindFirstChild("Torso") and char:FindFirstChild("Head") then
        local r6 = GetR6SkeletonPoints(char)
        if #r6 > 0 then return r6 end
    end

    if not QuantumConfig.CustomRigSupport then return segments end

    -- 3. Skinned Mesh Bone Hierarchy (Custom Skins & Deformed Rigs)
    local rigData = InspectAndCacheCustomRig(char)
    if rigData and #rigData.Bones > 0 then
        for _, bone in ipairs(rigData.Bones) do
            if #segments >= MAX_SKELETON_LINES then break end
            if bone.Parent and bone.Parent:IsA("Bone") then
                local ok, p1, p2 = pcall(function()
                    return bone.Parent.TransformedWorldCFrame.Position, bone.TransformedWorldCFrame.Position
                end)
                if ok and p1 and p2 and (p1 - p2).Magnitude > 0.15 then
                    table.insert(segments, {p1, p2})
                end
            end
        end
        if #segments > 0 then return segments end
    end

    -- 4. Custom Motor6D / Weld Rig Graph
    if rigData and #rigData.MotorJoints > 0 then
        for _, joint in ipairs(rigData.MotorJoints) do
            if #segments >= MAX_SKELETON_LINES then break end
            local p0, p1 = joint[1], joint[2]
            if p0 and p1 and p0.Parent and p1.Parent and (p0.Position - p1.Position).Magnitude > 0.15 then
                table.insert(segments, {p0.Position, p1.Position})
            end
        end
    end

    return segments
end

